{
  "EmailConfiguration": {
    "Host": "imap.gmail.com",
    "Port": 993,
    "Username": "your-email@gmail.com",
    "Password": "your-app-specific-password",
    "UseSsl": true,
    "Protocol": "IMAP",
    "FolderName": "INBOX",
    "MaxEmailsToRetrieve": 50,
    "AttachmentSaveDirectory": "Attachments",
    "MaxAttachmentSizeMB": 10,
    "TimeoutSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "EmailReaderApp": "Debug"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "EmailProviderExamples": {
    "Gmail": {
      "IMAP": {
        "Host": "imap.gmail.com",
        "Port": 993,
        "UseSsl": true,
        "Notes": "Requires app-specific password or OAuth2. Enable 2FA and generate app password."
      },
      "POP3": {
        "Host": "pop.gmail.com",
        "Port": 995,
        "UseSsl": true
      }
    },
    "Outlook": {
      "IMAP": {
        "Host": "outlook.office365.com",
        "Port": 993,
        "UseSsl": true
      },
      "POP3": {
        "Host": "outlook.office365.com",
        "Port": 995,
        "UseSsl": true
      }
    },
    "Yahoo": {
      "IMAP": {
        "Host": "imap.mail.yahoo.com",
        "Port": 993,
        "UseSsl": true,
        "Notes": "Requires app password. Go to Account Security > Generate app password."
      },
      "POP3": {
        "Host": "pop.mail.yahoo.com",
        "Port": 995,
        "UseSsl": true
      }
    },
    "AppleiCloud": {
      "IMAP": {
        "Host": "imap.mail.me.com",
        "Port": 993,
        "UseSsl": true,
        "Notes": "Requires app-specific password"
      }
    }
  }
}